# =============================================================================
# LensWise environment variables
# Copy to `.env.local` for local development, and set the same values in Vercel
# (Project → Settings → Environment Variables) for production.
# See docs/SUPABASE_SETUP.md and docs/VERCEL_DEPLOYMENT.md.
# =============================================================================

# --- Supabase (public — safe to expose to the browser) -----------------------
# Project URL and anon/publishable key. RLS enforces all access; the anon key
# is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (SECRET — server-side only, NEVER expose to the browser) --------
# Service-role key. Bypasses Row Level Security. Used only in Server Actions /
# Route Handlers for atomic registration and Super Admin bootstrap. Do NOT
# prefix with NEXT_PUBLIC_ and never reference it in a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Frames Data catalog import (SECRET — server-side only) ------------------
# Random bearer secret (32+ characters) for the protected batched import route.
# Generate a separate value for each environment. This is LensWise's ingest
# secret, not a Frames Data password or API credential.
FRAMES_DATA_IMPORT_SECRET=replace-with-a-random-32-character-secret

# --- Frames Data licensed local importer (SECRET — local machine only) --------
# Used only by `npm run import:frames-data`. Keep these in `.env.local`; do not
# add them to NEXT_PUBLIC variables or expose them in a browser bundle. For the
# proof-of-concept importer, do not copy the username/password to Vercel.
FRAMES_DATA_USERNAME=your-licensed-frames-data-username
FRAMES_DATA_PASSWORD=your-licensed-frames-data-password
# Change 3000 if Next.js starts LensWise on another port, such as 3001.
FRAMES_DATA_IMPORT_URL=http://127.0.0.1:3000/api/catalog/frames-data/import
# Safe defaults for a small incremental proof-of-concept import.
FRAMES_DATA_SEARCH_TERM=Modern
FRAMES_DATA_SAMPLE_LIMIT=100
FRAMES_DATA_REQUEST_DELAY_MS=150

# --- Platform Super Admin -----------------------------------------------------
# The single email that is promoted to platform Super Admin on first setup.
# Only this account can generate registration keys, view/disable organizations,
# etc. There is no UI to self-promote. Server-side only (never NEXT_PUBLIC_).
LENSWISE_SUPER_ADMIN_EMAIL=you@example.com

# --- Site URL (public) --------------------------------------------------------
# Absolute base URL of the deployment, no trailing slash. Used to build Stripe
# Checkout success/cancel and Customer Portal return URLs.
#   Local:      http://localhost:3000
#   Production: https://YOUR_DOMAIN
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (public — safe to expose to the browser) --------------------------
# Publishable key only. This is the ONLY Stripe value that may reach the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# --- Stripe (SECRET — server-side only, NEVER expose to the browser) ----------
# Secret key, webhook signing secret, and the recurring Price ID for the
# "LensWise Professional" plan. Do NOT prefix any of these with NEXT_PUBLIC_ and
# never import them into a client component. See docs/STRIPE_SETUP.md.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_ID=price_your-monthly-price-id

# --- Legacy proof-of-concept admin PIN (optional) -----------------------------
# The pre-SaaS Admin Pricing screen used a client-side PIN. It is superseded by
# Supabase Auth + org roles and can be left unset in production.
# NEXT_PUBLIC_DEMO_ADMIN_PIN=1234
